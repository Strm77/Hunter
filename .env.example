# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# Código de acesso único do app (mínimo 8 caracteres). Sem ele, o app fica bloqueado.
# Gere um código forte, por exemplo: openssl rand -base64 24
HUNTER_ACCESS_CODE=

# --- Banco hospedado (Supabase) ---
# Com as três variáveis abaixo, os dados ficam no banco. Sem elas, ficam em data/hunter.json.
# URL do projeto, ex.: https://<ref>.supabase.co
HUNTER_SUPABASE_URL=
# Chave publicável (sb_publishable_...). Sozinha ela não lê nem grava nada.
HUNTER_SUPABASE_KEY=
# Token secreto do servidor; o banco guarda só o SHA-256 dele (veja supabase/migrations).
HUNTER_DB_TOKEN=

# --- Arquivo local (opcional, só sem banco) ---
# HUNTER_DATA_DIR=./data
